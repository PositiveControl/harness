.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/
.harness/
# ab's isolated bd + memory data when bd init lands at repo root
# (canonical path is ~/.harness/airton_b/; bd may land here if the
# user cd's into <repo>/airton_b/ first). Leading slash = repo-root
# only; character/airton_b/ (persona data) stays tracked.
/airton_b/

# Third-plus-persona auto-silo dirs (harness-xbk.2). character/<name>/
# is tracked source (core.yaml, constitution.md, voice/*, seed
# memories, eval fixtures). The runtime subdirs below are per-install
# state: the persona's bd graph, its memory DB, and user-generated
# content under its sandboxed workspace. Regenerable or user-private,
# not source. corpus/ holds extracted markdown + chunk output from
# atc-4/atc-5 — bulky, regenerable from the source PDFs.
character/*/bd/
character/*/data/
# corpus/ mostly holds regenerable extract/chunk output (bulky, derivable
# from source PDFs). Ignore those subtrees only — keep hand-curated source
# files like synonyms.yaml tracked.
character/*/corpus/chunks/
character/*/corpus/markdown/
# atc_audio/ holds the LiveATC ingest pipeline output (harness-d8o2).
# Audio bytes (raw, norm) and parser output (meta, index.jsonl, stt) are
# derived — regenerable from ../atc-audio via the ingest scripts. Only
# human-labelled rows under utt/ (harness-hp8k, the ground truth that
# drives the eval) belong in the repo.
character/*/atc_audio/*
!character/*/atc_audio/utt/
character/airton_c/workspace/*
!character/airton_c/workspace/.gitkeep
data/
# Retrieval-eval fixtures need their CSV-backed corpora versioned even
# though they live under a data/ subdir (harness-kj2a).
!retrieval_eval/data/
!retrieval_eval/data/*
# returns_handler character ships a source CSV under data/ that gets
# loaded into a per-character TabularStore on session start (harness-kgpi).
# Only the CSV is tracked — the .sqlite files generated from it stay
# ignored via the *.sqlite rule below.
!character/returns_handler/data/
!character/returns_handler/data/*.csv
logs/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.env
.env.local
.DS_Store

# Dolt database files (added by bd init)
.dolt/
*.db

# Local Claude Code per-clone settings and interaction state
.claude/*
!.claude/agents/
scratch/**/*

# Benchmark artifacts — regenerable via scripts/bench_*.py and `harness eval *`
bench_results/

# IDE local config
.idea/

# Stray local auto-memory dir (canonical path is
# ~/.claude/projects/.../memory/ — a copy lands here if the harness
# is launched with HOME pointed at the repo root).
memory/

# One-off bd graph exports + unrelated top-level scratch
beads-export.jsonl
battista_comparison.md
